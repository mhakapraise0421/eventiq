# EventIQ environment settings.
# Copy to .env.local for development, and set real values on your host in
# production. Never commit real secrets.

# Public base URL used in metadata and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file location (defaults to .data/eventiq.db).
# DATABASE_PATH=

# Secret used to sign session and MFA cookies.
# If left unset, EventIQ generates one and stores it in .data/install-secrets.json.
# Set an explicit random value (32+ characters) in production.
# SESSION_SECRET=

# Key used to encrypt stored authenticator (TOTP) secrets.
# Falls back to a generated install secret when unset.
# MFA_ENCRYPTION_KEY=

# Key used to sign ticket QR payloads. Falls back to a generated install secret.
# TICKET_SECRET=

# Two-factor enforcement: off | all | staff | a comma-separated role list
# such as "staff,artists".
# Defaults to "staff,artists" in production and "off" in development.
# Artists and staff are never relaxed below the configured value.
# MFA_ENFORCEMENT=staff,artists

# Seed the sample database. Demo seeding only runs when this is true, or
# automatically outside production on an empty database.
# SEED_DEMO_DATA=false

# First administrator, created only when the database is empty and demo
# seeding is disabled. Password must be at least 12 characters.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=EventIQ Admin

# HMAC secret for /api/payments/webhook. Required in production; without it the
# endpoint refuses requests with 503 instead of accepting a shared default.
# PAYMENT_WEBHOOK_SECRET=

# Optional override for where generated install secrets are written.
# INSTALL_SECRETS_PATH=

# ---------------------------------------------------------------------------
# IQ by EventIQ — the in-app assistant.
# Public discovery reads approved, upcoming EventIQ listings. The signed-in
# organiser and artist workspace answers only from that account's own records.
# Nothing here exposes private data across accounts. Server-side only; keys are
# never sent to the browser.
# ---------------------------------------------------------------------------

# Set to false to hide the Ask IQ buttons and refuse the IQ APIs with 503.
# IQ_ENABLED=true

# Provider adapter: "mock" (no network, no cost, grounded answers composed
# locally) or "openai" (any OpenAI-compatible chat-completions endpoint).
# With no API key configured the app always falls back to "mock".
# IQ_PROVIDER=mock

# Chat-completions base URL. Defaults to https://api.openai.com/v1.
# IQ_BASE_URL=https://api.openai.com/v1

# Server-side API key. Leave unset to stay on the free mock provider.
# IQ_API_KEY=

# Model name for the provider you configured.
# IQ_MODEL=gpt-4o-mini

# Questions per person per UTC day, enforced server-side for one account and
# for one browser (anonymous visitors are also capped per IP). Lower these to
# cut provider spend; raise them only after checking your budget.
# IQ_DAILY_QUOTA=40
# IQ_ANON_IP_DAILY_QUOTA=120

